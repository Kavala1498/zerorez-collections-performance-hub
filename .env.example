# API
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Repository: "sheets" (default) or "memory" (local/tests without Google)
REPOSITORY=sheets
CACHE_TTL_MS=60000

# Google Sheets (service account — never commit real credentials)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the PEM private key; use \n for newlines in a single line value
GOOGLE_PRIVATE_KEY=
# Optional alternative path to a service-account JSON file (local only)
# GOOGLE_APPLICATION_CREDENTIALS=
