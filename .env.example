# ── API ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Comma-separated browser origins (Vercel/Netlify production URLs)
CORS_ORIGIN=http://localhost:5173

# Repository: "sheets" (default) or "memory" (local/tests without Google)
REPOSITORY=sheets
CACHE_TTL_MS=60000

# ── Google Sheets (service account — never commit real credentials) ──
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the PEM private key; use \n for newlines in a single line value
GOOGLE_PRIVATE_KEY=
# Optional alternative path to a service-account JSON file (local only)
# GOOGLE_APPLICATION_CREDENTIALS=

# ── Google OAuth (browser sign-in → ID token verified by API) ────────
# OAuth 2.0 Web client ID from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=
# Company domain required on the signed-in email (Google Workspace hd / email)
AUTH_ALLOWED_DOMAIN=zerorez.com
# Comma-separated admin emails (can upload). Placeholder — replace with real allowlist.
AUTH_ADMIN_EMAILS=admin@zerorez.com,collections-admin@zerorez.com
# Local/dev bypass (skip Google token verification). Auto-on when NODE_ENV=test.
AUTH_DISABLED=true
AUTH_BYPASS_EMAIL=dev@zerorez.com
AUTH_BYPASS_ROLE=admin
AUTH_BYPASS_NAME=Local Dev

# ── Web (Vite) ───────────────────────────────────────────────────────
# Leave empty in local dev to use the Vite proxy (/api → :3001)
# VITE_API_BASE_URL=https://your-api.example.com
# Same OAuth Web client ID as GOOGLE_OAUTH_CLIENT_ID
VITE_GOOGLE_OAUTH_CLIENT_ID=
# Mirror API AUTH_DISABLED for local UI without Google Sign-In
VITE_AUTH_DISABLED=true
