# ── Shared snapshot API (Vercel serverless + Postgres) ───────────────
# Neon / Supabase / Vercel Postgres connection string (required in production)
DATABASE_URL=

# Optional: only requests with this PIN (header x-upload-pin) can POST/DELETE.
# If unset, anyone who can reach the API can replace the shared snapshot.
UPLOAD_PIN=

# Optional CORS allowlist (comma-separated). Same-origin Vercel deploy needs none.
# CORS_ORIGIN=http://localhost:5173

# Local API port (scripts/dev-api.ts)
# PORT=3001

# ── Web (Vite) ───────────────────────────────────────────────────────
# Leave empty in local/Vercel same-origin deploys (uses /api/…).
# Set only if the API is hosted on a different origin.
# VITE_API_BASE_URL=https://your-app.vercel.app
