{
  "name": "@zerorez/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Zerorez Collections Performance Hub API",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "setup-sheets": "tsx scripts/setup-sheets.ts"
  },
  "dependencies": {
    "@zerorez/shared": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "google-auth-library": "^11.3.4",
    "googleapis": "^190.0.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
